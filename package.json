        }
      ]
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "pnpm dlx @raycast/api@latest publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/openai": "^4.0.18",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@raycast/api": "^1.104.23",
    "ai": "^7.0.35",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
