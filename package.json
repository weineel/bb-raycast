          "value": "hi"
        }
      ]
    },
    {
      "name": "defaultTargetLanguage",
      "title": "Default Translation Target",
      "description": "Initially selected by the Translate command",
      "type": "dropdown",
      "required": true,
      "default": "zh-CN",
      "data": [
        {
          "title": "Simplified Chinese",
          "value": "zh-CN"
        },
        {
          "title": "Traditional Chinese",
          "value": "zh-TW"
        },
        {
          "title": "English",
